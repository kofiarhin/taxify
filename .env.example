NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/taxify
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
FARE_BASE=10
FARE_PER_KM=3
FARE_PER_MINUTE=1
COMMISSION_RATE=0.1

# Required only when running `npm run seed:users`. Supply a unique value locally;
# do not commit or log it.
SEED_PASSWORD=
# Existing seeded-user passwords are preserved unless this is exactly `true`.
RESET_SEEDED_PASSWORDS=false
# Production seeding remains blocked unless this is exactly `true`.
ALLOW_PRODUCTION_SEED=false

# Optional local E2E overrides. `npm run test:e2e` starts isolated local
# services with MongoDB Memory Server and uses these defaults when unset.
E2E_BASE_URL=http://127.0.0.1:5173
E2E_API_PORT=5000
E2E_CLIENT_PORT=5173
